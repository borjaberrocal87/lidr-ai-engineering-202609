PORT=3000
# URL base de la API FastAPI (en Docker Compose: http://api:8000)
ESTIMATOR_API_BASE_URL=http://localhost:8000
ESTIMATOR_TIMEOUT_MS=60000
# La comparativa con estrategias de pago puede tardar minutos.
CHUNKING_TIMEOUT_MS=600000
# El badge de la navbar y Ajustes no deben bloquear el resto de páginas.
CONFIG_TIMEOUT_MS=3000
CONFIG_CACHE_TTL_MS=15000
# Postgres. Si se deja vacío, el cliente usa un repositorio en memoria (sin persistencia).
DATABASE_URL=postgres://estimator:estimator@localhost:5432/estimator_web
NODE_ENV=development

# --- Sesión 9 — wizard RAG ---------------------------------------------------
# Deben coincidir con RETRIEVAL_API_KEY y ESTIMATE_API_KEY del backend.
RAG_RETRIEVAL_API_KEY=dev-retrieval-key
RAG_ESTIMATE_API_KEY=dev-estimate-key
# Timeouts del wizard (el retrieval y la generación pueden tardar).
RAG_TIMEOUT_MS=120000
RAG_GENERATE_TIMEOUT_MS=300000
