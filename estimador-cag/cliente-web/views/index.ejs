<%- include('partials/head', { title: 'Nueva estimación' }) %>
<%- include('partials/header') %>

<div class="max-w-3xl mx-auto py-12 px-4">
  <h1 class="text-3xl font-bold tracking-tighter text-white mb-8">Nueva estimación</h1>

  <% if (error) { %>
    <div class="p-4 rounded-md bg-brand/15 border border-brand text-brand-soft mb-6">
      <p class="font-bold text-white mb-1">No se pudo generar la estimación</p>
      <p class="text-sm"><%= error %></p>
    </div>
  <% } %>

  <form method="post" action="/estimations" class="space-y-5" data-form-loading>
    <div>
      <div class="flex items-center justify-between mb-1">
        <label for="description" class="label">Descripción o transcripción</label>
        <label class="text-xs font-bold tracking-tight text-brand hover:text-brand-soft cursor-pointer">
          Subir .txt
          <input type="file" accept=".txt,text/plain" class="hidden" data-upload />
        </label>
      </div>
      <textarea
        id="description"
        name="description"
        rows="12"
        class="field"
        placeholder="Pega una transcripción de reunión o describe el proyecto: alcance, funcionalidades, integraciones y restricciones…"
        data-textarea
      ><%= values.description || '' %></textarea>
      <div class="flex items-center justify-between mt-1">
        <p class="text-xs text-white/50">
          Entre <%= context.descriptionMin %> y <%= context.descriptionMax %> caracteres.
        </p>
        <span class="text-xs text-white/70" data-upload-status></span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label for="project_type" class="label">Tipo de proyecto</label>
        <select id="project_type" name="project_type" class="field [&>option]:bg-ink-dark">
          <% projectTypes.forEach(function (value) { %>
            <option value="<%= value %>" <%= values.project_type === value ? 'selected' : '' %>>
              <%= humanize(value) %>
            </option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="detail_level" class="label">Nivel de detalle</label>
        <select id="detail_level" name="detail_level" class="field [&>option]:bg-ink-dark">
          <% detailLevels.forEach(function (value) { %>
            <option value="<%= value %>" <%= values.detail_level === value ? 'selected' : '' %>>
              <%= humanize(value) %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label for="output_format" class="label">Formato de salida</label>
        <select id="output_format" name="output_format" class="field [&>option]:bg-ink-dark">
          <% outputFormats.forEach(function (value) { %>
            <option value="<%= value %>" <%= values.output_format === value ? 'selected' : '' %>>
              <%= humanize(value) %>
            </option>
          <% }); %>
        </select>
      </div>
      <div>
        <label for="prompt_version" class="label">Versión del prompt</label>
        <select id="prompt_version" name="prompt_version" class="field [&>option]:bg-ink-dark">
          <% context.availableVersions.forEach(function (value) { %>
            <option value="<%= value %>" <%= values.prompt_version === value ? 'selected' : '' %>>
              <%= value %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="pt-2">
      <button type="submit" class="btn-primary" data-submit>
        <span data-submit-label>Generar estimación</span>
        <svg data-spinner class="hidden ml-2 h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
      </button>

      <div data-status-panel class="hidden mt-4 p-4 rounded-md bg-ink/30 border border-white/10 items-center gap-3" role="status" aria-live="polite">
        <svg class="h-5 w-5 animate-spin text-brand shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
        <div class="flex-1 text-sm">
          <span class="text-white/90">Conectando con el servicio IA…</span>
        </div>
      </div>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
