<%- include('../partials/head', { title: 'Expansión del corpus' }) %>
<%- include('../partials/header') %>

<%
  const status = job ? job.status : run.status;
  const processed = job ? job.documents_processed : 0;
%>

<div class="max-w-3xl mx-auto py-12 px-4 space-y-6">
  <h1 class="text-3xl font-bold tracking-tighter text-white">Expansión del corpus</h1>

  <% if (jobError) { %>
    <div class="p-4 rounded-md border border-red-400/40 bg-red-400/10 text-red-200 text-sm">
      <%= jobError %>
    </div>
  <% } %>

  <div class="card space-y-2 text-white/90">
    <div><span class="text-white/50">Job:</span> <span class="tabular-nums"><%= run.jobId %></span></div>
    <div><span class="text-white/50">Tipo de chunk:</span> <%= run.chunkType %></div>
    <div>
      <span class="text-white/50">Estado:</span>
      <span class="<%= status === 'completed' ? 'badge-success' : 'badge' %>"><%= status %></span>
    </div>
    <div>
      <span class="text-white/50">Documentos:</span>
      <span class="tabular-nums"><%= processed %> / <%= run.documentsTotal %></span>
    </div>
    <div><span class="text-white/50">Lanzada:</span> <%= formatDate(run.createdAt) %></div>
    <% if (job && job.finished_at) { %>
      <div><span class="text-white/50">Fin:</span> <%= formatDate(job.finished_at) %></div>
    <% } %>
    <% if (run.error) { %>
      <div class="text-red-200"><span class="text-white/50">Error:</span> <%= run.error %></div>
    <% } %>
  </div>

  <% if (stats) { %>
    <div class="rounded-md border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between bg-ink/40 px-3 py-2">
        <span class="font-bold text-white">Corpus ahora</span>
        <span class="text-white/70 text-sm tabular-nums"><%= stats.total_chunks %> chunks</span>
      </div>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-white/10">
          <% stats.collections.forEach(function (row) { %>
            <tr>
              <td class="p-3 text-white/90"><%= row.collection %></td>
              <td class="p-3 text-right tabular-nums"><%= row.documents %> docs</td>
              <td class="p-3 text-right tabular-nums"><%= row.chunks %> chunks</td>
              <td class="p-3 text-right">
                <span class="<%= row.hnsw_indexed ? 'badge-success' : 'badge' %>">
                  HNSW <%= row.hnsw_indexed ? 'sí' : 'no' %>
                </span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="flex items-center gap-4">
    <a href="/corpus" class="btn-primary">Volver al corpus</a>
    <a href="/corpus/new" class="text-white/50 font-bold hover:text-white tracking-tight">
      Añadir otro lote
    </a>
  </div>

  <% if (status === 'pending' || status === 'running') { %>
    <script>
      setTimeout(function () {
        window.location.reload();
      }, 2500);
    </script>
  <% } %>
</div>

<%- include('../partials/footer') %>
