<%- include('../partials/head', { title: 'Corpus / Índice' }) %>
<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto py-12 px-4 space-y-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tighter text-white">Corpus / Índice</h1>
      <p class="text-white/60 text-sm mt-1">
        Añade documentos NUEVOS al corpus y observa cómo crece. Los chunks nuevos
        entran en el índice HNSW sin reconstruirlo.
      </p>
    </div>
    <a href="/corpus/new" class="btn-primary shrink-0">Añadir documentos</a>
  </div>

  <% if (error) { %>
    <div class="p-4 rounded-md border border-red-400/40 bg-red-400/10 text-red-200">
      <%= error %>
    </div>
  <% } %>

  <% if (stats) { %>
    <div class="rounded-md border border-white/10 overflow-hidden">
      <div class="flex items-center justify-between bg-ink/40 px-3 py-2">
        <span class="font-bold text-white">Estado del corpus</span>
        <span class="text-white/70 text-sm tabular-nums"><%= stats.total_chunks %> chunks</span>
      </div>
      <table class="w-full text-sm">
        <thead class="text-white/40 text-xs uppercase tracking-wider">
          <tr>
            <th class="text-left p-3 font-bold">Colección</th>
            <th class="text-right p-3 font-bold">Documentos</th>
            <th class="text-right p-3 font-bold">Chunks</th>
            <th class="text-right p-3 font-bold">HNSW</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          <% stats.collections.forEach(function (row) { %>
            <tr>
              <td class="p-3 text-white/90"><%= row.collection %></td>
              <td class="p-3 text-right tabular-nums"><%= row.documents %></td>
              <td class="p-3 text-right tabular-nums"><%= row.chunks %></td>
              <td class="p-3 text-right">
                <% if (row.hnsw_indexed) { %>
                  <span class="badge-success">sí</span>
                <% } else { %>
                  <span class="badge">no</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="p-4 rounded-md bg-red-400/10 border border-red-400/40 text-red-200 text-sm">
      No se pudieron leer las estadísticas del corpus.
    </div>
  <% } %>

  <div>
    <h2 class="text-lg font-bold tracking-tight text-white mb-3">Últimas expansiones</h2>
    <% if (!runs.length) { %>
      <div class="p-4 rounded-md border border-white/10 bg-ink/20 text-white/60 text-sm">
        Todavía no has añadido documentos en esta sesión.
      </div>
    <% } else { %>
      <div class="rounded-md border border-white/10 overflow-hidden">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-white/10">
            <% runs.forEach(function (run) { %>
              <tr>
                <td class="p-3">
                  <a href="/corpus/runs/<%= run.id %>" class="text-white hover:text-brand-soft font-bold">
                    <%= run.chunkType %>
                  </a>
                  <div class="text-white/40 text-xs tabular-nums"><%= formatDate(run.createdAt) %></div>
                </td>
                <td class="p-3 text-right tabular-nums text-white/70">
                  <%= run.documentsTotal %> docs
                </td>
                <td class="p-3 text-right">
                  <span class="<%= run.status === 'completed' ? 'badge-success' : 'badge' %>">
                    <%= run.status %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
