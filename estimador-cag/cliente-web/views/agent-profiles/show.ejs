<%- include('../partials/head', { title: 'Perfil de agente' }) %>
<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto py-12 px-4">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div class="flex items-center gap-4">
      <img
        src="<%= profile.avatarDataUrl || '/lidr/imagotipo_horizontal_negativo_blanco.svg' %>"
        alt=""
        class="h-16 w-16 rounded-full object-cover border border-white/15 bg-ink/40"
      />
      <div>
        <h1 class="text-3xl font-bold tracking-tighter text-white"><%= profile.name %></h1>
        <p class="text-white/60 text-sm mt-1">
          <%= profile.agentType %>
          <% if (profile.isDefault) { %> · <span class="text-brand-soft font-bold">predeterminado</span><% } %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <a href="/agent-profiles" class="text-white/60 font-bold hover:text-white tracking-tight">← Perfiles</a>
      <a href="/agent-profiles/<%= profile.id %>/edit" class="btn-primary">Editar</a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="p-4 mb-6 rounded-md bg-brand/15 border border-brand text-brand-soft"><%= notice %></div>
  <% } %>

  <% if (profile.persona) { %>
    <section class="mb-6">
      <p class="text-xs text-white/50 uppercase tracking-tight mb-1">Persona</p>
      <div class="p-4 rounded-md bg-ink/30 border border-white/10 text-sm text-white/80 whitespace-pre-line"><%= profile.persona %></div>
    </section>
  <% } %>

  <section class="mb-6">
    <p class="text-xs text-white/50 uppercase tracking-tight mb-2">Knobs del agente</p>
    <% const rows = [
      ['model', 'Modelo'],
      ['reasoning_effort', 'Esfuerzo de razonamiento'],
      ['max_iterations', 'Máximo de iteraciones'],
      ['search_top_k', 'Top K de búsqueda'],
      ['search_distance_threshold', 'Umbral de distancia'],
    ]; %>
    <div class="rounded-md border border-white/10 overflow-hidden">
      <table class="w-full text-sm">
        <tbody class="divide-y divide-white/10">
          <% rows.forEach(function (row) { %>
            <tr>
              <td class="p-3 text-white/60"><%= row[1] %></td>
              <td class="p-3 text-right text-white font-mono">
                <%= profile.config[row[0]] ?? '(por defecto del servicio)' %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-8">
    <p class="text-xs text-white/50 uppercase tracking-tight mb-2">Cuerpo que se envía al servicio IA</p>
    <pre class="p-3 rounded bg-black/40 text-xs text-white/80 overflow-x-auto"><%= JSON.stringify(configPayload, null, 2) %></pre>
  </section>

  <div class="flex items-center gap-4">
    <a href="/rag-estimations/new" class="btn-primary">Usar en una estimación</a>
    <form method="post" action="/agent-profiles/<%= profile.id %>/delete" onsubmit="return confirm('¿Eliminar este perfil?');">
      <button type="submit" class="text-sm font-bold text-red-200 hover:text-white tracking-tight">Eliminar perfil</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
