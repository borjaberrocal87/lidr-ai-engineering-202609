<%- include('../partials/head', { title: 'Perfiles de agente' }) %>
<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto py-12 px-4">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tighter text-white">Perfiles de agente</h1>
      <p class="text-white/60 text-sm mt-1">
        Presets nombrados y personalizables para el agente que conduce el wizard.
      </p>
    </div>
    <a href="/agent-profiles/new" class="btn-primary">Nuevo perfil</a>
  </div>

  <% if (notice) { %>
    <div class="p-4 mb-6 rounded-md bg-brand/15 border border-brand text-brand-soft"><%= notice %></div>
  <% } %>

  <% if (!profiles.length) { %>
    <div class="p-4 rounded-md border border-white/10 bg-ink/20 text-white/60">
      Todavía no hay perfiles. Crea el primero para ajustar modelo, esfuerzo y búsqueda.
    </div>
  <% } else { %>
    <ul class="space-y-3">
      <% profiles.forEach(function (profile) { %>
        <li class="rounded-md border border-white/10 bg-white/5 p-4 flex items-center gap-4">
          <img
            src="<%= profile.avatarDataUrl || '/lidr/imagotipo_horizontal_negativo_blanco.svg' %>"
            alt=""
            class="h-12 w-12 rounded-full object-cover border border-white/15 bg-ink/40 shrink-0"
          />
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <a href="/agent-profiles/<%= profile.id %>" class="font-bold tracking-tight text-white hover:text-brand"><%= profile.name %></a>
              <% if (profile.isDefault) { %><span class="badge">predeterminado</span><% } %>
            </div>
            <p class="text-white/50 text-xs mt-1 truncate">
              <%= profile.agentType %>
              <% if (profile.config.model) { %> · modelo <%= profile.config.model %><% } %>
              <% if (profile.config.reasoning_effort) { %> · esfuerzo <%= profile.config.reasoning_effort %><% } %>
              <% if (profile.config.max_iterations) { %> · máx. <%= profile.config.max_iterations %> iter.<% } %>
            </p>
          </div>
          <div class="flex items-center gap-3 text-xs font-bold tracking-tight shrink-0">
            <% if (!profile.isDefault) { %>
              <form method="post" action="/agent-profiles/<%= profile.id %>/default">
                <button type="submit" class="text-brand hover:text-brand-soft">Hacer predeterminado</button>
              </form>
            <% } %>
            <a href="/agent-profiles/<%= profile.id %>/edit" class="text-white/70 hover:text-white">Editar</a>
          </div>
        </li>
      <% }); %>
    </ul>
  <% } %>
</div>

<%- include('../partials/footer') %>
