<%
  const modules = verification?.modules || [];
  const confirmed = Boolean(verification?.confirmed_at);
  const initialHours = verification?.total_hours ?? 0;
  const initialCost = verification?.total_cost_eur ?? 0;
  const notes = verification?.notes || '';
%>

<div class="space-y-6">
  <div>
    <h2 class="text-lg font-bold tracking-tight text-white mb-1">5 · Validación</h2>
    <p class="text-white/50 text-sm">
      Revisa las horas y la tarifa de cada tarea. El total y el coste se
      recalculan al guardar; esta acción no vuelve a llamar al LLM.
    </p>
  </div>

  <% if (!modules.length) { %>
    <div class="p-4 rounded-md border border-red-400/40 bg-red-400/10 text-red-200">
      Todavía no hay horas que validar. Estima primero las horas por tarea.
    </div>
    <a href="/rag-estimations/<%= run.id %>?step=review" class="text-brand font-bold hover:text-brand-soft tracking-tight">
      ← Ir a la revisión
    </a>
  <% } else { %>
    <% if (confirmed) { %>
      <div class="p-4 rounded-md bg-brand/10 border border-brand text-brand-soft">
        Validación guardada:
        <span class="font-bold text-white tabular-nums"><%= initialHours %></span> horas ·
        <span class="font-bold text-white tabular-nums"><%= initialCost %> €</span>.
      </div>
    <% } %>

    <form method="post" action="/rag-estimations/<%= run.id %>/verify" class="space-y-6" data-form-loading>
      <%- include('_editable_modules', { modules, mode: 'cost' }) %>

      <div>
        <button type="button" id="add-module" class="text-sm font-bold tracking-tight text-brand hover:text-brand-soft">
          + Añadir módulo
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label for="notes" class="label">Notas de validación</label>
          <textarea id="notes" name="notes" rows="3" class="field" placeholder="Supuestos aceptados, recortes de alcance, dudas pendientes…"><%= notes %></textarea>
        </div>
        <div class="p-4 rounded-md bg-ink/30 border border-white/10">
          <p class="text-xs text-white/50 uppercase tracking-tight">Total recalculado</p>
          <p class="text-2xl font-bold text-white tabular-nums">
            <span data-total-hours><%= initialHours %></span> horas
          </p>
          <p class="text-lg font-bold text-brand-soft tabular-nums">
            <span data-total-cost><%= initialCost %></span> €
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 pt-2">
        <button type="submit" class="btn-primary" data-submit>
          <span data-submit-label>Guardar validación</span>
          <svg data-spinner class="hidden ml-2 h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
        </button>
        <a href="/rag-estimations/<%= run.id %>?step=hours" class="text-white/50 font-bold hover:text-white tracking-tight">
          ← Volver a las horas
        </a>
      </div>
    </form>
  <% } %>
</div>
