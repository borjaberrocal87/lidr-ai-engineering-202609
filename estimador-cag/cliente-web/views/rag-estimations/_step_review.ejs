<%
  const modules = structure || [];
%>

<div class="space-y-6">
  <div class="p-4 rounded-md bg-ink/30 border border-white/10">
    <p class="text-sm text-white/70">
      Revisa la descomposición antes de estimar horas: añade, elimina o renombra
      módulos y tareas. Al continuar, cada tarea se busca contra el corpus
      histórico para derivar sus horas.
    </p>
  </div>

  <% if (!modules.length) { %>
    <div class="p-4 rounded-md border border-brand bg-brand/10 text-brand-soft">
      Todavía no hay estructura generada. Vuelve a
      <a href="/rag-estimations/<%= run.id %>?step=generation" class="underline font-bold">Estructura</a>.
    </div>
  <% } else { %>
    <form method="post" action="/rag-estimations/<%= run.id %>/estimate-hours" class="space-y-6" data-form-loading>
      <%- include('_editable_modules', { modules, mode: 'structure' }) %>

      <div>
        <button type="button" id="add-module" class="text-sm font-bold tracking-tight text-brand hover:text-brand-soft">
          + Añadir módulo
        </button>
      </div>

      <div class="flex items-center gap-4 pt-2">
        <button type="submit" class="btn-primary" data-submit>
          <span data-submit-label>Estimar horas por tarea →</span>
          <svg data-spinner class="hidden ml-2 h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
        </button>
        <a href="/rag-estimations/<%= run.id %>?step=generation" class="text-white/50 font-bold hover:text-white tracking-tight">
          ← Volver a la estructura
        </a>
      </div>
      <p class="text-xs text-white/40">
        Una búsqueda vectorial por tarea contra el corpus histórico.
      </p>
    </form>
  <% } %>
</div>
