<%
  const trace = agentTrace || null;
  const steps = trace && Array.isArray(trace.steps) ? trace.steps : [];
%>

<% if (trace) { %>
  <div class="p-4 rounded-md bg-ink/30 border border-white/10 space-y-3">
    <div class="flex flex-wrap items-center gap-3">
      <p class="text-xs text-white/50 uppercase tracking-tight">Traza del agente</p>
      <% if (trace.model) { %><span class="badge"><%= trace.model %></span><% } %>
      <% if (trace.iterations != null) { %>
        <span class="text-xs text-white/60"><%= trace.iterations %> iteraciones</span>
      <% } %>
      <% if (trace.stopped_reason) { %>
        <span class="text-xs text-white/60">parada: <%= trace.stopped_reason %></span>
      <% } %>
    </div>

    <% if (!steps.length) { %>
      <p class="text-white/50 text-sm">El agente respondió sin llamar a ninguna tool.</p>
    <% } else { %>
      <ol class="space-y-3">
        <% steps.forEach(function (step) { %>
          <li class="rounded-md border border-white/10 bg-white/5 p-3">
            <div class="flex items-center justify-between gap-3 mb-1">
              <span class="text-xs font-bold tracking-tight text-brand">STEP <%= step.step %></span>
              <span class="text-xs font-mono text-white/60"><%= step.tool %></span>
            </div>
            <div class="space-y-1 text-sm">
              <p class="text-white/80">
                <span class="text-white/50">reasoning:</span>
                <%= step.reasoning_summary || "(no reasoning summary emitted)" %>
              </p>
              <pre class="mt-1 p-2 rounded bg-black/40 text-xs text-white/80 overflow-x-auto"><%= step.tool %>(<%= JSON.stringify(step.tool_args || {}, null, 2) %>)</pre>
              <p class="text-white/80">
                <span class="text-white/50">observation:</span>
                <%= step.observation %>
              </p>
            </div>
          </li>
        <% }); %>
      </ol>
    <% } %>
  </div>
<% } %>
