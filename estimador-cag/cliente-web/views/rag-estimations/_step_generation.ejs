<%
  const modules = structure || [];
  const totalTasks = modules.reduce((total, module) => total + module.tasks.length, 0);
%>

<div class="space-y-6">
  <div class="p-4 rounded-md bg-ink/30 border border-white/10">
    <p class="text-sm text-white/70">
      La estructura es una descomposición libre del brief: módulos y tareas, sin
      horas y sin fuentes. Las horas se derivan después, tarea a tarea, contra el
      corpus histórico.
    </p>
  </div>

  <% if (!estimate) { %>
    <div class="p-4 rounded-md border border-white/10 bg-ink/20 text-white/60">
      Todavía no hay estructura. Genera la descomposición del brief para continuar.
    </div>
  <% } else { %>
    <div class="flex flex-wrap items-center gap-3">
      <span class="badge"><%= estimate.confidence %></span>
      <span class="text-sm text-white/70">
        <span class="text-white font-bold tabular-nums"><%= modules.length %></span> módulos ·
        <span class="text-white font-bold tabular-nums"><%= totalTasks %></span> tareas
      </span>
    </div>

    <% if (estimate.insufficient_context_explanation) { %>
      <div class="p-4 rounded-md border border-brand bg-brand/10 text-brand-soft">
        <p class="font-bold text-white mb-1">Brief insuficiente</p>
        <p class="text-sm"><%= estimate.insufficient_context_explanation %></p>
      </div>
    <% } %>

    <% if (estimate.reasoning) { %>
      <div class="p-4 rounded-md bg-ink/30 border border-white/10">
        <p class="text-xs text-white/50 uppercase tracking-tight mb-1">Razonamiento</p>
        <p class="text-sm text-white/80"><%= estimate.reasoning %></p>
      </div>
    <% } %>

    <% if (modules.length) { %>
      <div class="space-y-4">
        <% modules.forEach(function (module) { %>
          <div class="rounded-md border border-white/10 overflow-hidden">
            <div class="px-4 py-3 bg-ink/40">
              <p class="text-white/90 font-bold tracking-tight"><%= module.name %></p>
              <% if (module.description) { %>
                <p class="text-white/50 text-xs mt-1"><%= module.description %></p>
              <% } %>
            </div>
            <table class="w-full text-sm">
              <thead class="text-white/50">
                <tr>
                  <th class="text-left p-3 font-bold tracking-tight">Tarea</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                <% module.tasks.forEach(function (task) { %>
                  <tr>
                    <td class="p-3 align-top">
                      <p class="text-white/90"><%= task.name %></p>
                      <% if (task.description) { %>
                        <p class="text-white/50 text-xs mt-1"><%= task.description %></p>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } %>

  <form method="post" action="/rag-estimations/<%= run.id %>/generate" class="pt-2" data-form-loading>
    <button type="submit" class="btn-primary" data-submit>
      <span data-submit-label><%= estimate ? 'Regenerar estructura' : 'Generar estructura' %></span>
      <svg data-spinner class="hidden ml-2 h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
      </svg>
    </button>
    <% if (estimate && modules.length) { %>
      <a href="/rag-estimations/<%= run.id %>?step=review" class="ml-4 text-brand font-bold hover:text-brand-soft tracking-tight">
        Revisar estructura →
      </a>
    <% } %>
    <a href="/rag-estimations/<%= run.id %>?step=brief" class="ml-4 text-white/50 font-bold hover:text-white tracking-tight">
      ← Volver al brief
    </a>
  </form>
</div>
