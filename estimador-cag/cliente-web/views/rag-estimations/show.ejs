<%- include('../partials/head', { title: 'Estimación RAG' }) %>
<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto py-12 px-4">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tighter text-white">Estimación RAG</h1>
      <p class="text-white/60 text-sm mt-1">
        <%= formatDate(run.createdAt) %> ·
        estado <span class="text-white/80"><%= run.status %></span>
        <% if (run.idempotencyKey) { %>
          · clave <span class="font-mono text-xs text-white/70"><%= run.idempotencyKey %></span>
        <% } %>
      </p>
    </div>
    <div class="flex items-center gap-4">
      <a href="/rag-estimations" class="text-brand font-bold hover:text-brand-soft tracking-tight">
        ← Historial
      </a>
      <a href="/rag-estimations/new" class="btn-primary">Nueva</a>
    </div>
  </div>

  <%- include('_progress', { steps, stepIndex, run }) %>

  <% if (error) { %>
    <div class="p-4 mb-6 rounded-md border border-red-400/40 bg-red-400/10 text-red-200">
      <%= error %>
    </div>
  <% } %>
  <% if (notice) { %>
    <div class="p-4 mb-6 rounded-md bg-brand/15 border border-brand text-brand-soft">
      <%= notice %>
    </div>
  <% } %>

  <% if (step === 'brief') { %>
    <%- include('_step_brief') %>
  <% } else if (step === 'retrieval') { %>
    <%- include('_step_retrieval') %>
  <% } else if (step === 'assembly') { %>
    <%- include('_step_assembly') %>
  <% } else if (step === 'generation') { %>
    <%- include('_step_generation') %>
  <% } else { %>
    <%- include('_step_verification') %>
  <% } %>
</div>

<script src="/ragEstimation.js"></script>
<%- include('../partials/footer') %>
