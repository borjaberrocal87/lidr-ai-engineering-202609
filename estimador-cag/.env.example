APP_ENV=development
# Nivel de logging (DEBUG, INFO, ...). Gobierna también los logs de las llamadas al LLM.
LOG_LEVEL=DEBUG
# Formato de los logs: console (texto legible) | json (para agregadores)
LOG_FORMAT=console

# Proveedor LLM activo: openai | anthropic | custom
LLM_PROVIDER=openai
# Modelo del proveedor. Déjalo vacío para usar el default del proveedor activo
# (openai -> gpt-4o-mini, anthropic -> claude-haiku-4-5). El proveedor custom no
# tiene default: es obligatorio indicar uno.
LLM_MODEL=
# Modelo de fallback (vacío = sin fallback). LiteLLM decide el proveedor por el
# nombre del modelo: claude-haiku-4-5, gpt-4o-mini, openai/<modelo>...
LLM_FALLBACK_MODEL=
# Modo del Router de LiteLLM:
#   fallback = el primario se usa siempre; solo cae al fallback si el primario falla
#   balanced = reparte las peticiones entre primario y fallback (simple-shuffle)
LLM_ROUTING_MODE=fallback
# Temperatura de generación (no aplica al proveedor anthropic)
TEMPERATURE=0.2

# Límites de la llamada al LLM
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
# Longitud mínima y máxima de la descripción del proyecto aceptada (caracteres)
DESCRIPTION_MIN_LENGTH=20
DESCRIPTION_MAX_LENGTH=50000

OPEN_AI_KEY=
ANTHROPIC_API_KEY=

# Proveedor custom (OpenAI-compatible)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Caché de respuestas: memory (por defecto, sin infraestructura) | redis | none
CACHE_BACKEND=memory
# TTL de las entradas de caché (segundos)
CACHE_TTL=86400
# URL de Redis (solo si CACHE_BACKEND=redis). En docker-compose se sobreescribe
# a redis://redis:6379.
REDIS_URL=redis://localhost:6379

# --- Sesión 4 — salida estructurada -----------------------------------------
# Reintentos de validación del JSON estructurado (se re-promptea al modelo con
# el error de Pydantic hasta agotar este número).
STRUCTURED_MAX_RETRIES=2

# --- Sesión 4 — guardrails ----------------------------------------------------
# Interruptor general de guardrails de entrada/salida.
GUARDRAILS_ENABLED=true
# Moderación vía API de OpenAI (requiere OPEN_AI_KEY). Si no hay clave, solo
# se aplican las heurísticas regex de prompt-injection y PII.
GUARDRAIL_MODERATION_ENABLED=true

# --- Sesión 4 — caché semántica ----------------------------------------------
# Requiere Redis Stack (RediSearch) y un endpoint de embeddings.
SEMANTIC_CACHE_ENABLED=true
# Similitud coseno mínima (0..1) para considerar un acierto de caché semántica.
SEMANTIC_CACHE_THRESHOLD=0.85
# TTL de las entradas semánticas (segundos).
SEMANTIC_CACHE_TTL=86400
# Si true, registra aciertos potenciales sin servirlos (para calibrar).
SEMANTIC_CACHE_LOG_ONLY=false
# Embeddings. Si EMBEDDING_BASE_URL + EMBEDDING_API_KEY están rellenos se usa
# ese endpoint OpenAI-compatible; si no, se usa OPEN_AI_KEY.
# La dimensión del índice vectorial la deduce el servicio del propio modelo
# (qwen3-embedding = 4096, text-embedding-3-small = 1536). Al cambiar de modelo
# se crea un índice nuevo (estimations_<modelo>_<dims>); borra el anterior con:
#   docker compose exec redis redis-cli FT.DROPINDEX <nombre_viejo> DD
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Sesión 5 — memoria conversacional y adjuntos ---------------------------
# Pares user+assistant que se conservan en la ventana deslizante de cada sesión.
MAX_CONVERSATION_TURNS=6
# Tope por adjunto extraído (caracteres), para proteger el presupuesto del prompt.
MAX_ATTACHMENT_CHARS=60000
# Modelo para el extractor de metadata por turno (vacío = usa LLM_MODEL).
METADATA_EXTRACTOR_MODEL=

# --- Sesión 5 (directo) — ACB, tier, compresión -----------------------------
# Versión del prompt conversacional (vacío = v3, con bloque <audiencia> por tier).
CONVERSATIONAL_PROMPT_VERSION=
# Modelo del Critic (auditor ACB). Vacío = usa LLM_MODEL.
CRITIC_MODEL=
# Iteraciones máximas del bucle Actor-Critic-Boss (>= 1).
BOSS_MAX_ITERATIONS=2
# Modelo del resumidor acumulativo / detector de anclas LLM. Vacío = usa LLM_MODEL.
COMPRESSION_MODEL=
# Detección de anclas: heuristic (regex, sin coste) | llm (clasificador por turno).
ANCHOR_DETECTION_MODE=heuristic

# URL base de la API que consume el frontend (Streamlit). En local apunta al
# backend; docker-compose la sobreescribe a http://api:8000 (red interna).
API_BASE_URL=http://localhost:8000
