APP_ENV=development
# Nivel de logging (DEBUG, INFO, ...). Gobierna también los logs de las llamadas al LLM.
LOG_LEVEL=DEBUG
# Formato de los logs: console (texto legible) | json (para agregadores)
LOG_FORMAT=console

# Proveedor LLM activo: openai | anthropic | custom
LLM_PROVIDER=openai
# Modelo del proveedor. Déjalo vacío para usar el default del proveedor activo
# (openai -> gpt-4o-mini, anthropic -> claude-haiku-4-5). El proveedor custom no
# tiene default: es obligatorio indicar uno.
LLM_MODEL=
# Temperatura de generación (no aplica al proveedor anthropic)
TEMPERATURE=0.2

# Límites de la llamada al LLM
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
# Longitud mínima y máxima de la transcripción aceptada (caracteres)
TRANSCRIPTION_MIN_LENGTH=10
TRANSCRIPTION_MAX_LENGTH=50000

OPEN_AI_KEY=
ANTHROPIC_API_KEY=

# Proveedor custom (OpenAI-compatible)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# URL base de la API que consume el frontend (Streamlit). En local apunta al
# backend; docker-compose la sobreescribe a http://api:8000 (red interna).
API_BASE_URL=http://localhost:8000
